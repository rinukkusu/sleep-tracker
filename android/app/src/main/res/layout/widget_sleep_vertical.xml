<?xml version="1.0" encoding="utf-8"?>
<!-- Label pinned to the top, buttons to the bottom, timer or round start button centered in between. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wach"
        android:textColor="#9AA0C3"
        android:textSize="13sp" />

    <!-- Awake: "15 Min." under the label, no ticking clock -->
    <TextView
        android:id="@+id/widget_ago"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#E8EAF6"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/widget_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textColor="#E8EAF6"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9AA0C3"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/widget_moon"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/widget_moon_button"
            android:contentDescription="Schläft"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_moon_zz" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/widget_pause"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_wake"
            android:contentDescription="Pause"
            android:src="@drawable/ic_widget_pause" />

        <ImageButton
            android:id="@+id/widget_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_sleep"
            android:contentDescription="Aufgewacht"
            android:src="@drawable/ic_widget_stop" />
    </LinearLayout>
</LinearLayout>
